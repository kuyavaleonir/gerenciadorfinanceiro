# Configurações do Banco de Dados / Supabase
# Se SUPABASE_URL e SUPABASE_KEY estiverem preenchidos, o sistema utilizará o Supabase online.
# Caso contrário, o sistema utilizará automaticamente o SQLite local (financeiro.db).

USE_SUPABASE=false
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-key-aqui

# Porta e host da aplicação FastAPI
PORT=8000
HOST=0.0.0.0
